{
  "manifest_version": 3,
  "name": "Claude Fact Guard",
  "version": "2.0.0",
  "description": "Fact-checks Claude AI responses with Perplexity Sonar (web-grounded) and pastes a literal correction back into Claude.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Claude Fact Guard — open side panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "sidePanel", "scripting", "activeTab"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://api.perplexity.ai/*",
    "https://openrouter.ai/*"
  ]
}
